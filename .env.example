# Database
POSTGRES_DB=ent_ready
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT (сгенерируй случайные строки 32+ символов)
JWT_ACCESS_SECRET=your_random_access_secret_here_32chars
JWT_REFRESH_SECRET=your_random_refresh_secret_here_32chars

# Server
SERVER_ADDR=:8080

# CORS (через запятую, все фронтенд-домены)
CORS_ORIGINS=https://your-frontend-domain.com

# Brevo HTTP API (Railway-compatible; takes priority over Resend and SMTP).
# Add and verify this sender in Brevo. Use an API key, not an SMTP key.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ENT Ready

# Optional alternative: SMTP (outbound SMTP may be blocked by hosting).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=your@yandex.kz
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@yandex.kz

# URL бэкенда — прописывается в Next.js во время сборки
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api/v1

# development/test explicitly allow local OTP logging; production requires email provider
APP_ENV=production

# TEMPORARY pre-launch mode: all requested email OTPs are 0000, no emails sent.
# Currently defaults to true even on Railway. Set false before real users join.
OTP_DEMO_MODE=true
